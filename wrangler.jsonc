// Serves the site from ./public and runs src/worker.js for /api/* (visitor analytics).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locatewright",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },

  // Analytics database (Cloudflare D1). Wrangler creates a database called "locatewright"
  // on the first deploy; tables are created automatically on first use.
  // Secret (set in the dashboard or with `npx wrangler secret put ADMIN_TOKEN`): ADMIN_TOKEN
  "d1_databases": [
    { "binding": "DB", "database_name": "locatewright" }
  ]
}
